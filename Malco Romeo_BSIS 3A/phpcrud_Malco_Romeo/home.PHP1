text-decoration: none;
}
</style><style>
/* The container that fills available space. It's the positioning context. /
#slideshow-holder {
width: 100%;
position: relative;
flex-grow: 1; / Replaces flex-grow Tailwind class for clarity /
overflow: hidden;
padding: 1rem; / Replaces p-4 Tailwind class */
}
/* UI controls should not be text-selectable. */
#nav-controls.select-none,
#theme-toggle.select-none {
user-select: none;
-webkit-user-select: none;
}
/* The element that is scaled and centered. /
#slideshow-wrapper {
width: 1280px;
height: 720px;
position: absolute;
top: 50%;
left: 50%;
transform-origin: center;
transform: translate(-50%, -50%) scale(var(--scale-factor, 1));
transition: transform 0.3s ease-in-out;
/ Visual styles moved here from the holder */
border-radius: 0.5rem;
box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
overflow: hidden;
}
/* Update slide container styles */
.slide-container {
width: 100%;
height: 100%;
overflow: hidden;
position: absolute;
top: 0;
left: 0;
opacity: 0;
pointer-events: none;
transition: opacity 0.5s ease-in-out;
}
/* Make the active slide visible */
.slide-container.active {
opacity: 1;
pointer-events: auto;
}
